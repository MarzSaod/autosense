DATABASE_URL=
GEMINI_API_KEY=
PORT=4000
# Comma-separated extra allowed origins; localhost:5173 and
# https://autosense-phi.vercel.app are always allowed.
FRONTEND_ORIGIN=

# Outbound email. All four SMTP_* values are needed for mail to be sent; with
# any of them missing, bookings and contact messages still work and the send is
# skipped with a log line. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where contact-form notifications go. Falls back to shop_settings.email.
SHOP_EMAIL=
